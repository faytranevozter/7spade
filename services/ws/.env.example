# WebSocket Service

# Server listen port
PORT=8081

# JWT signing secret (must match the API service)
JWT_SECRET=

# PostgreSQL connection URL
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Dedicated Redis for the cross-replica relay (pub/sub, owner leases, room
# snapshots). Falls back to REDIS_URL when unset, so single-replica deploys can
# leave this blank. Point all ws replicas at the SAME instance.
WS_REDIS_URL=

# External API base URL for persisting game history (disabled if empty)
API_URL=

# Shared secret for the API's /internal endpoints (must match the API service).
# The API refuses to start when this is empty; keep it distinct from JWT_SECRET.
INTERNAL_API_SECRET=dev-internal-secret

# Required to enable machine-authenticated redacted room inspection for the
# admin API. Must exactly match WS_ADMIN_SERVICE_SECRET in admin-api.
# This is server-to-server only and must never be exposed to a browser.
WS_INSPECTION_SECRET=
