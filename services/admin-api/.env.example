# Admin API Service

# Server listen port
PORT=8082

# Required: PostgreSQL connection URL. Use restricted admin API credentials outside local development.
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Required: signing secret used only for administrator access tokens.
ADMIN_JWT_SECRET=

# Required: 32-byte encryption key encoded as hex, base64, or a 32-character string.
# Used to encrypt administrator MFA secrets at rest.
ADMIN_MFA_ENCRYPTION_KEY=

# Exact admin frontend origin allowed to make credentialed browser requests.
ADMIN_FRONTEND_ORIGIN=http://localhost:5174

# Set true when the admin frontend and API are served over HTTPS.
ADMIN_SECURE_COOKIES=false

# Environment displayed in the protected administrator shell.
APP_ENV=development

# One-time bootstrap command inputs. Run `go run ./cmd/bootstrap-admin`.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
