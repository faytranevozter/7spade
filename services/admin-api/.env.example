# Admin API Service

# Server listen port
PORT=8082

# Required: PostgreSQL connection URL. Use restricted admin API credentials outside local development.
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Required: signing secret used only for administrator access tokens.
ADMIN_JWT_SECRET=

# Required: persistent, high-entropy secret used to derive the key that encrypts
# administrator MFA secrets at rest. `openssl rand -hex 32` is suitable.
ADMIN_MFA_ENCRYPTION_KEY=

# Exact admin frontend origin allowed to make credentialed browser requests.
ADMIN_FRONTEND_ORIGIN=http://localhost:5174

# Set true when the admin frontend and API are served over HTTPS.
ADMIN_SECURE_COOKIES=false

# Environment displayed in the protected administrator shell.
APP_ENV=development

# Optional S3-compatible public asset URL used to render existing skin assets.
# Configure the remaining variables only when the admin API should upload assets.
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

# Seed uploader bucket CORS origins (player and admin frontend URLs).
SKIN_ASSET_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional API and WS health endpoints shown by the dashboard. Leave blank when
# a service is not deployed in this environment.
API_HEALTH_URL=http://localhost:8080/health
WS_HEALTH_URL=http://localhost:8081/health

# Dedicated server-side WS inspection endpoint and machine credential used for
# redacted live room summaries. Must match WS_INSPECTION_SECRET in the WS service.
# Keep both unset to return live unavailable data. Never expose this secret to a browser.
WS_ADMIN_URL=http://localhost:8081
WS_ADMIN_SERVICE_SECRET=

# Server-validated links to the authoritative operational tools. Optional in
# development; all five are required when APP_ENV=production.
OPERATIONS_METRICS_URL=
OPERATIONS_LOGS_URL=
OPERATIONS_TRACES_URL=
OPERATIONS_DEPLOYMENTS_URL=
OPERATIONS_RUNBOOK_URL=

# One-time bootstrap command inputs. Run `go run ./cmd/bootstrap-admin`.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
